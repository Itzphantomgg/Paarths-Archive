# Database configuration (Prisma with SQLite local relational DB)
DATABASE_URL="file:./dev.db"

# JWT Auth Secret for Session Cookies
JWT_SECRET="paarth-cinematic-archive-jwt-secret-key-32-chars-minimum-2026"

# Optional Supabase Integration (Leave empty to use local Prisma SQLite)
